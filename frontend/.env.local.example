# Copy to .env.local. Nothing here is secret — HMAC_KEY/AES_KEY/JWT_SECRET must never appear in frontend/.
NEXT_PUBLIC_API_URL=http://localhost:8000
# No Mapbox token needed — basemap runs on MapLibre GL against CARTO's free
# tokenless tiles (components/map/CityMap.tsx). See DECISIONS.md.

# Dev-only mock data layer (lib/mock/). Off by default — never set to true here.
# Set NEXT_PUBLIC_MOCK_MODE=true in your own .env.local for local UI work
# against fixtures that match the frozen API contract shapes byte-for-byte.
# A persistent on-screen banner appears whenever this is on.
NEXT_PUBLIC_MOCK_MODE=false
